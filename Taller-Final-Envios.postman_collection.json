      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Header X-Servidor-Procesado\", () => pm.expect(pm.response.headers.get(\"X-Servidor-Procesado\")).to.eql(\"Equipo-\" + pm.collectionVariables.get(\"N\")));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Red-Equipo",
            "value": "CIAF-{{N}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/recurso",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "recurso"
          ]
        }
      }
    },
