    {
      "name": "6. Verificacion de headers de respuesta (CORS + custom)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Access-Control-Allow-Origin correcto\", () => pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\")).to.eql(\"http://localhost:5500\"));",
              "pm.test(\"X-Servidor-Procesado presente\", () => pm.response.to.have.header(\"X-Servidor-Procesado\"));",
              "pm.test(\"Content-Type JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "console.log(pm.response.headers.toObject());"
            ]
          }
        }
